// 1. IllustratedCard — the most-used widget in the app
IllustratedCard(
  title: String,
  subtitle: String?,
  illustration: String,           // asset path from AppIllustrations
  backgroundColor: Color,
  illustrationAlignment: Alignment,
  illustrationSize: double,       // 100-140px
  onTap: VoidCallback?,
  trailing: Widget?,
)

// 2. LunaCard — base card, all cards extend this
LunaCard(
  child: Widget,
  padding: EdgeInsets?,
  margin: EdgeInsets?,
  color: Color?,                  // defaults to white
  borderColor: Color?,
  shadowStyle: LunaShadow,        // card | elevated | subtle
)

// 3. LunaEmptyState — NEVER show empty without this
LunaEmptyState(
  illustration: String,           // character asset path
  title: String,
  subtitle: String,               // often "He left this space for you 🌸"
  action: LunaButton?,
)

// 4. LunaChip — mood/symptom chips
LunaChip(
  label: String,
  icon: IconData?,
  thumbnail: String?,             // character thumbnail (tiny 32px)
  isSelected: bool,
  onTap: VoidCallback,
  selectedColor: Color,           // defaults to rosePrimary
)
